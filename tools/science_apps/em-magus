#!/usr/bin/env python3
"""Agent CLI for the same bounded queue used by the manual science workbench."""
import argparse
import json
import os
from pathlib import Path
import sys
import urllib.error
import urllib.parse
import urllib.request


def api(path, payload=None):
    key = os.environ.get('LOCAL_BACKEND_API_KEY') or os.environ.get('OH_SESSION_API_KEYS_0')
    if not key:
        raise RuntimeError('Runtime session key is unavailable')
    request = urllib.request.Request('http://127.0.0.1:8000/api/science' + path,
        data=json.dumps(payload).encode() if payload is not None else None,
        headers={'X-Session-API-Key': key, 'Content-Type': 'application/json'})
    with urllib.request.urlopen(request, timeout=20) as response:
        return response.read()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    submit = commands.add_parser('submit', help='Submit one neutral molecule XYZ for crystal search')
    submit.add_argument('xyz', type=Path)
    submit.add_argument('--title', default='MAGUS molecular crystal search')
    submit.add_argument('--model-size', choices=['small', 'medium', 'large'], default='medium')
    submit.add_argument('--molecules-per-cell', type=int, default=4)
    submit.add_argument('--population-size', type=int, default=6)
    submit.add_argument('--generations', type=int, default=3)
    submit.add_argument('--volume-min', type=float, required=True, help='Whole cell volume in A^3')
    submit.add_argument('--volume-max', type=float, required=True, help='Whole cell volume in A^3')
    submit.add_argument('--cores', type=int, default=2)
    submit.add_argument('--memory-mb', type=int, default=2048)
    commands.add_parser('apps')
    commands.add_parser('jobs')
    for name in ['status', 'cancel', 'download']:
        command = commands.add_parser(name)
        command.add_argument('job_id')
        if name == 'download':
            command.add_argument('directory', type=Path)
    args = parser.parse_args()
    if args.command == 'submit':
        payload = vars(args).copy()
        payload.pop('command')
        xyz = payload.pop('xyz')
        if xyz.stat().st_size > 65536:
            raise ValueError('XYZ exceeds 64 KiB')
        payload.update(app_id='magus', task='search', method='MACE-OFF23', xyz=xyz.read_text())
        result = api('/jobs', payload)
    elif args.command in {'apps', 'jobs'}:
        result = api('/' + args.command)
    else:
        path = '/jobs/' + urllib.parse.quote(args.job_id, safe='')
        if args.command == 'cancel':
            result = api(path + '/cancel', {})
        else:
            result = api(path)
            if args.command == 'download':
                job = json.loads(result)
                args.directory.mkdir(parents=True, exist_ok=True)
                saved = []
                for entry in job['files']:
                    name = entry['name']
                    destination = args.directory / name
                    if Path(name).name != name or destination.exists() or destination.is_symlink():
                        raise ValueError('Unsafe or existing download target: ' + name)
                    with destination.open('xb') as stream:
                        stream.write(api(path + '/files/' + urllib.parse.quote(name, safe='')))
                    saved.append(str(destination))
                result = json.dumps({'saved': saved}).encode()
    print(json.dumps(json.loads(result), ensure_ascii=False, indent=2))


if __name__ == '__main__':
    try:
        main()
    except urllib.error.HTTPError as exc:
        print(f'Science API HTTP {exc.code}: {exc.read().decode()}', file=sys.stderr)
        sys.exit(1)
    except (OSError, ValueError, RuntimeError) as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)
