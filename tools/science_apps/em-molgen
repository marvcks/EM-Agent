#!/usr/bin/env python3
"""Run ChemTSv3 Pareto molecular generation through the shared EM-Agent science queue."""
import argparse
import json
import os
from pathlib import Path
import sys
import urllib.error
import urllib.parse
import urllib.request


def api(path, payload=None):
    key = os.environ.get('LOCAL_BACKEND_API_KEY') or os.environ.get('OH_SESSION_API_KEYS_0')
    if not key:
        raise RuntimeError('Runtime session key is unavailable')
    request = urllib.request.Request('http://127.0.0.1:8000/api/science' + path,
        data=json.dumps(payload).encode() if payload is not None else None,
        headers={'X-Session-API-Key': key, 'X-EM-Agent-Source': 'agent',
                 'Content-Type': 'application/json'})
    with urllib.request.urlopen(request, timeout=20) as response:
        return response.read()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    submit = commands.add_parser('submit', help='Start ChemTSv3 MCTS generation with the bundled models')
    submit.add_argument('--workers', type=int, default=2, help='Search workers, 1-7 (one extra core merges the pool)')
    submit.add_argument('--seconds', type=int, default=600, help='Generation budget per worker, 60-7200')
    submit.add_argument('--seed', type=int, default=20261030)
    submit.add_argument('--cores', type=int, help='Total cores 2-8; defaults to workers + 1')
    submit.add_argument('--memory-mb', type=int, default=4096)
    submit.add_argument('--title', default='')
    commands.add_parser('apps')
    commands.add_parser('jobs')
    for name in ['status', 'cancel', 'download']:
        command = commands.add_parser(name)
        command.add_argument('job_id')
        if name == 'download':
            command.add_argument('directory', type=Path)
    args = parser.parse_args()
    if args.command == 'submit':
        payload = {'app_id': 'molgen', 'task': 'generation', 'method': 'ChemTSv3',
                   'xyz': '', 'smiles': '', 'title': args.title,
                   'molgen_workers': args.workers, 'molgen_seconds': args.seconds,
                   'molgen_seed': args.seed, 'cores': args.cores or args.workers + 1,
                   'memory_mb': args.memory_mb}
        result = api('/jobs', payload)
    elif args.command in {'apps', 'jobs'}:
        result = api('/' + args.command)
    else:
        path = '/jobs/' + urllib.parse.quote(args.job_id, safe='')
        result = api(path + '/cancel', {}) if args.command == 'cancel' else api(path)
        if args.command == 'download':
            job = json.loads(result)
            args.directory.mkdir(parents=True, exist_ok=True)
            saved = []
            for entry in job['files']:
                name = entry['name']
                destination = args.directory / name
                if Path(name).name != name or destination.exists() or destination.is_symlink():
                    raise ValueError('Unsafe or existing download target: ' + name)
                with destination.open('xb') as stream:
                    stream.write(api(path + '/files/' + urllib.parse.quote(name, safe='')))
                saved.append(str(destination))
            result = json.dumps({'saved': saved}).encode()
    value = json.loads(result)
    print(json.dumps(value, ensure_ascii=False, indent=2))


if __name__ == '__main__':
    try:
        main()
    except urllib.error.HTTPError as exc:
        print(f'Science API HTTP {exc.code}: {exc.read().decode()}', file=sys.stderr)
        sys.exit(1)
    except (OSError, ValueError, RuntimeError) as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)
